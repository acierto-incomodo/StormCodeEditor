{
  "name": "stormcodeeditor-ide",
  "version": "1.0.5",
  "author": "StormGamesStudios <meliodas.aitor@gmail.com>",
  "description": "A minimal Electron-based code editor built with Monaco",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npx electron .",
    "build": "electron-builder --win nsis",
    "release:win": "electron-builder --win nsis --publish always",
    "dist": "npm run dist:clean && electron-builder --win nsis appx --linux deb AppImage",
    "dist:clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dist:win": "npm run dist:clean && electron-builder --win nsis appx",
    "dist:win:nsis": "npm run dist:clean && electron-builder --win nsis",
    "dist:win:appx": "npm run dist:clean && electron-builder --win appx",
    "dist:linux": "npm run dist:clean && electron-builder --linux deb AppImage",
    "dist:linux:deb": "npm run dist:clean && electron-builder --linux deb",
    "dist:linux:appimage": "npm run dist:clean && electron-builder --linux AppImage",
    "rebuild:node-pty": "npm.cmd exec electron-rebuild -- --force --only node-pty"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "@banegasn/m3-button": "^2.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.acierto-incomodo.stormcodeeditor",
    "productName": "StormCodeEditor IDE",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!languages{,/**/*}",
      "!build{,/**/*}",
      "!README.md"
    ],
    "extraResources": [
      {
        "from": "languages",
        "to": "languages",
        "filter": [
          "**/*.json"
        ]
      }
    ],
    "win": {
      "artifactName": "StormGamesStudios-Setup.${ext}",
      "target": [
        "nsis",
        "appx"
      ]
    },
    "appx": {
      "applicationId": "StormCodeEditor",
      "identityName": "StormGamesStudios.StormCodeEditor",
      "publisherDisplayName": "StormGamesStudios"
    },
    "linux": {
      "artifactName": "StormGamesStudios-Setup.${ext}",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "acierto-incomodo",
      "repo": "StormCodeEditor"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "lzma-native@8.0.6": true,
    "node-pty@1.1.0": true
  }
}
